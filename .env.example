# Bazaga ulanish satri.
# `docker compose up -d` bilan ko'tarilgan baza uchun shu qiymat to'g'ri keladi.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ishtop

# SSL manzilga qarab o'z-o'zidan hal qilinadi: localhost — o'chiq,
# uzoqdagi baza (Neon, Supabase, Railway) — yoqiq. Bekor qilish uchun:
# DATABASE_SSL=on | off | no-verify

# Sessiyani imzolash uchun. Ishlab chiqarishda MAJBURIY.
# Yaratish: openssl rand -base64 32
SESSION_SECRET=

# Telegram Login Widget. Botni @BotFather orqali yarating, keyin
# /setdomain buyrug'i bilan saytingiz domenini bog'lang.
# Ikkalasi ham bo'lmasa, kirish ekranida namunaviy foydalanuvchi tugmasi chiqadi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Ishlab chiqarish build'ida namunaviy kirishni ochish (faqat demo uchun).
# ALLOW_DEV_LOGIN=1

# ——— Push bildirishnomalar (v4, §1.5) ———
# Kalit juftini yaratish: npm run vapid
# Ikkalasi ham bo'lmasa push jim o'chiq turadi va Profilda bo'lim ko'rinmaydi.
# Ochiq kalit brauzerga ham kerak, shuning uchun ikki nusxada.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Push xizmati bog'lanish uchun ishlatadi — pochta yoki sayt manzili
VAPID_SUBJECT=mailto:admin@example.com

# Kunlik yig'ma xabarni yuboradigan yo'l uchun parol.
# Cron har soat chaqiradi: curl -X POST -H "Authorization: Bearer $CRON_SECRET" .../api/push/digest
# Yaratish: openssl rand -base64 32
CRON_SECRET=
