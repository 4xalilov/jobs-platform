{
  "extends": [
    "stylelint-config-standard-scss"
  ],
  "plugins": [
    "stylelint-high-performance-animation"
  ],
  "rules": {
    "plugin/no-low-performance-animation-properties": [
      true,
      {
        "severity": "error",
        "ignoreProperties": [
          "color",
          "background-color",
          "border-color",
          "fill",
          "stroke"
        ]
      }
    ],
    "custom-property-empty-line-before": null,
    "rule-empty-line-before": null,
    "at-rule-empty-line-before": null,
    "comment-empty-line-before": null,
    "declaration-empty-line-before": null,
    "declaration-block-single-line-max-declarations": null,
    "value-keyword-case": null,
    "scss/comment-no-empty": null,
    "scss/dollar-variable-pattern": null,
    "scss/double-slash-comment-empty-line-before": null,
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "keyframes-name-pattern": null,
    "no-descending-specificity": null,
    "declaration-property-value-no-unknown": null,
    "media-feature-range-notation": null,
    "alpha-value-notation": null,
    "color-function-notation": null,
    "at-rule-no-deprecated": null,
    "scss/at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "custom-variant"
        ]
      }
    ],
    "selector-pseudo-class-no-unknown": [
      true,
      {
        "ignorePseudoClasses": [
          "global",
          "local"
        ]
      }
    ],
    "color-no-hex": [
      true,
      {
        "message": "Rang qo'lda yozilmaydi. styles/themes.json ga token qo'shing va var(--...) bilan ishlatilsin."
      }
    ],
    "color-named": [
      "never",
      {
        "message": "Rang nomi ishlatilmaydi (white, black...). styles/themes.json dagi token ishlatilsin."
      }
    ],
    "declaration-property-value-disallowed-list": [
      {
        "color": [
          "/^rgba?\\(/",
          "/^hsla?\\(/"
        ],
        "background": [
          "/^rgba?\\(/",
          "/^hsla?\\(/"
        ],
        "background-color": [
          "/^rgba?\\(/",
          "/^hsla?\\(/"
        ],
        "border-color": [
          "/^rgba?\\(/",
          "/^hsla?\\(/"
        ]
      },
      {
        "message": "rgb()/hsl() to'g'ridan-to'g'ri yozilmaydi — themes.json ga token qo'shing."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "app/globals.css"
      ],
      "rules": {
        "at-rule-no-unknown": null,
        "import-notation": null
      }
    },
    {
      "files": [
        "styles/_variables.scss"
      ],
      "rules": {
        "declaration-property-value-disallowed-list": null,
        "color-no-hex": null
      }
    }
  ],
  "ignoreFiles": [
    "app/themes.generated.css",
    ".next/**",
    "node_modules/**"
  ]
}
