{
  "name": "jobs-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.mjs",
    "db:seed": "node --env-file-if-exists=.env.local db/seed.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "themes": "node scripts/build-themes.mjs",
    "predev": "node scripts/build-themes.mjs",
    "prebuild": "node scripts/build-themes.mjs",
    "lint:css": "stylelint \"**/*.{css,scss}\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "sass": "^1.102.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-high-performance-animation": "^2.0.0",
    "typescript": "^5"
  }
}
